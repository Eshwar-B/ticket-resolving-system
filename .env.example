# ==============================================================================
# Enterprise AI Platform — Local Development Environment Configuration
# ==============================================================================
# Security Notice: This file contains NON-SENSITIVE local defaults only.
# Cost Notice: Strictly ₹0 / Local-first open-source tooling.
# Copy this file to `.env` for local execution: `cp .env.example .env`
# ==============================================================================

# Environment profile
ENVIRONMENT=local
PROJECT_NAME=enterprise-ai-platform

# ------------------------------------------------------------------------------
# PostgreSQL 16 (Core Infrastructure)
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=postgres

# Service-Specific Logical Database Names
IDENTITY_DB_NAME=identity_db
TICKET_DB_NAME=ticket_db
KNOWLEDGE_DB_NAME=knowledge_db
WORKFLOW_DB_NAME=workflow_db
NOTIFICATION_DB_NAME=notification_db
USAGE_DB_NAME=usage_db
AI_DB_NAME=ai_db

# ------------------------------------------------------------------------------
# Redis 7 (Core Infrastructure)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_password

# ------------------------------------------------------------------------------
# Apache Kafka (KRaft Mode - No ZooKeeper)
# ------------------------------------------------------------------------------
KAFKA_BROKER=kafka:9092
KAFKA_EXTERNAL_PORT=9092
KAFKA_INTERNAL_PORT=29092
KAFKA_CONTROLLER_PORT=9093
KAFKA_NODE_ID=1
KAFKA_CLUSTER_ID=4L622nShTUiTwyMVZxwJxA

# ------------------------------------------------------------------------------
# OpenTelemetry Collector (Observability Profile)
# ------------------------------------------------------------------------------
OTEL_COLLECTOR_HOST=otel-collector
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_HTTP_ENDPOINT=http://localhost:4318

# ------------------------------------------------------------------------------
# Keycloak (Phase 2 Core Preview)
# ------------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_password
KEYCLOAK_PORT=8080

# ------------------------------------------------------------------------------
# MinIO (Object Storage Preview)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_dev_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ------------------------------------------------------------------------------
# Local Hardware Constraints & Limits (16 GB Machine Cap)
# ------------------------------------------------------------------------------
POSTGRES_MEM_LIMIT=512m
REDIS_MEM_LIMIT=256m
KAFKA_MEM_LIMIT=1024m
KAFKA_JVM_PERFORMANCE_OPTS="-Xmx512m -Xms256m"

